# One key is enough: an OpenRouter key selects Gemma 4 (google/gemma-4-31b-it)
# for the model and OpenRouter's web plugin for search.
CC_OPENROUTER_API_KEY=

# Optional
# CC_LLM_MODEL=google/gemma-4-31b-it-20260402   # pin a model release
# CC_SEARCH_MODEL=                              # a different model for web search
# CC_MAX_CLAIMS=15                              # claims checked per article
# CC_MAX_SOURCES=3                              # sources read per claim
# CC_WORKERS=8                                  # claims checked at once
# CC_SNAPSHOTS=1                                # 0 turns page snapshots off
# CC_OFFICIAL_DOMAINS=example.gov               # added to the built-in tiers
# CC_REFERENCE_DOMAINS=example.org
# CC_DEFAULT_TIERS=1                            # 0 uses only the two lists above
# CC_DATA_DIR=data                              # reports, snapshots, CPI cache
# CC_CACHE_SECONDS=3600                         # reuse a recent report of the same URL

# Any other OpenAI-compatible API instead of OpenRouter
# CC_LLM_BASE_URL=http://localhost:4000
# CC_LLM_API_KEY=
# CC_LLM_MODEL=
# CC_SEARXNG_URL=http://localhost:8888          # self-hosted SearXNG for search
